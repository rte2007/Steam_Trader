# Copy this file to .env or run: python configure.py
# Never commit .env or a Steam Guard maFile.

# Accounts and APIs
LISSKINS_API_KEY=
DM_PRIVATE_KEY=
DM_PUBLIC_KEY=
STEAM_API_KEY=
STEAM_ID=
STEAM_LOGIN=
STEAM_PASSWORD=
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
STEAM_PARTNER32=
STEAM_TRADE_TOKEN=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
RUSTTM_API_KEY=
MARKET_CSGO_API_KEY=

# Path to the owner's private Steam Guard file (never commit it)
DMM_STEAM_MAFILE=private/steam_guard.maFile
DMCS_STEAM_MAFILE=private/steam_guard.maFile

# LIS-SKINS -> DMarket Order (Rust)
MIN_PROFIT_PCT=8
MIN_BUY_USD=0.30
MAX_BUY_USD=0
MAX_CONCURRENT=1
MAX_DAILY_SPEND_USD=0
MAX_REBUYS_PER_NAME=1
AUTO_BUY=false
AUTO_ACCEPT=true
AUTO_DEPOSIT=true
POLL_INTERVAL=30
TRADE_POLL_SEC=15
STEAM_LOGIN_RETRY_SEC=300
TG_CONTROL_ENABLED=false
LIVE_CONFIRMATIONS_REQUIRED=2
LIVE_CONFIRMATION_WINDOW_SEC=300
MAX_LOSS_PCT=0
ONE_SHOT=false

# DMarket -> rust.tm (kept recovery-only by default)
DMM_MIN_PROFIT_PCT=1
DMM_MARKET_FEE_PCT=10
DMM_MIN_BUY_USD=0.30
DMM_MAX_BUY_USD=0
DMM_MAX_ACTIVE=1
DMM_MAX_DAILY_SPEND_USD=0
DMM_MAX_SLIPPAGE_PCT=3
DMM_ORDER_UNDERCUT_USD=0
DMM_POLL_SEC=60

# DMarket -> Market.CS2 Order
DMCS_MIN_PROFIT_PCT=1
DMCS_MARKET_FEE_PCT=10
DMCS_MIN_MARKET_ORDER_USD=2
DMCS_MIN_SALES_14D=300
DMCS_MIN_BUY_USD=0.30
DMCS_MAX_BUY_USD=0
DMCS_MAX_ACTIVE=1
DMCS_MAX_DAILY_SPEND_USD=0
DMCS_MAX_SLIPPAGE_PCT=3
DMCS_POLL_SEC=300
